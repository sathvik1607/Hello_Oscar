# Used by `npm run build` only — the dev server keeps reading .env.local.
#
# Points the built app at the same backend the Flutter app uses. That is what makes
# realtime work ACROSS devices: WebSocket state is process-local, so a task created
# on the phone only reaches a browser connected to the SAME process.
VITE_BACKEND_URL=https://developement-branch.onrender.com
VITE_SARVAM_SPEAKER=dev
VITE_VAD_SILENCE_MS=800
VITE_WAKE_WORD=oscar
