# Used by `npm run build` only — the dev server keeps reading .env.local.
#
# ⚠️ On a VERCEL build the dashboard's own VITE_BACKEND_URL wins over this file.
# Keep the two in sync anyway: this value is what a local `npm run build` produces,
# and a mismatch is how a hand-built bundle ends up talking to a different backend
# than the deployed one while looking identical.
#
# Points the built app at the same backend the Flutter app uses. That is what makes
# realtime work ACROSS devices: WebSocket state is process-local, so a task created
# on the phone only reaches a browser connected to the SAME process.
#
# 🔴 2026-10-05: switched from `alumnxailabs-epa-3.onrender.com` to
# `hello-oscar-backend.onrender.com` — per the owner, THIS is the URL the
# just-submitted Play Store/App Store Flutter builds point at, so the web app
# now matches mobile. Verified live via `curl -I .../health` at the time of
# this change (200, x-app-version header present). `epa-3` is a separate,
# still-live Render service (backs the admin panel) — not the same database.
VITE_BACKEND_URL=https://hello-oscar-backend.onrender.com
VITE_SARVAM_SPEAKER=dev
VITE_VAD_SILENCE_MS=800
VITE_WAKE_WORD=oscar

VITE_FIREBASE_API_KEY=AIzaSyDMjrYKmmQeCutcPb2SuTY-5dlqCPYJvUo
VITE_FIREBASE_AUTH_DOMAIN=hellooscar-c39b2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hellooscar-c39b2
VITE_FIREBASE_STORAGE_BUCKET=hellooscar-c39b2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=344881774120
VITE_FIREBASE_APP_ID=1:344881774120:web:2acae9c115be939e0fff1d
VITE_FIREBASE_VAPID_KEY=BEvr97wgo5JHJmh6LEhd6r51v9_pMmkB1jgE1zdtAf1xk63CHIBypl9AS8yOqYplzPqQkl04R8sNefWwD-cdHV0
