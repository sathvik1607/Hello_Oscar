# The Oscar backend. Everything — REST, the app WebSocket, and the Sarvam speech
# relays — is derived from this one value, so pointing at another environment is a
# one-line change and cannot leave half the app talking to the wrong host.
#
# ws:// and wss:// are derived automatically (http→ws, https→wss). A deployed page
# MUST be https, because getUserMedia refuses to hand over a microphone on an
# insecure origin — and an https page opening a ws:// socket is blocked as mixed
# content, which reads as "voice is broken" rather than as a URL problem.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Default Sarvam voice. bulbul:v3 speaker names — see SPEAKERS in src/lib/liveVoice.ts.
VITE_SARVAM_SPEAKER=dev

# How much silence ends your spoken turn. 800ms keeps sentences whole; 400 chops
# a thinking pause into two separate questions. Coherence beats speed here.
VITE_VAD_SILENCE_MS=800

# The word that wakes it. An open microphone is not an open door.
VITE_WAKE_WORD=oscar

# Microphone noise gate — OFF by default and it must stay that way unless the
# threshold below has been tuned to your room. Shipped on with a guessed value once
# and it silenced the product on any mic quieter than the developer's.
# VITE_MIC_GATE=1
# VITE_MIC_GATE_RMS=0.02

# 🔴 There is NO VITE_SARVAM_KEY and there must never be one. Vite inlines every
# VITE_* value into the shipped bundle, so a key here is readable by anyone who
# opens the page. The key lives on the backend; speech is relayed through it.

# Which voice engine the app uses. `sarvam` (DEFAULT) is the five-socket path that
# has been in production for months. `gemini` opts into Gemini 3.1 Flash Live —
# one socket, native barge-in, ~1.2 s to first audio, but it persists only a lossy
# transcript and its fabrication guards are unfinished.
#
# ⚠️ BUILD-TIME, not runtime. Vite inlines this and tree-shakes the unused engine,
# so changing it needs a rebuild (or a dev-server restart), not just a redeploy of
# the same bundle.
#
# 🔴 The Gemini path PERSISTS NOTHING. The Sarvam path posts every spoken turn to
# /chat/stream, so it lands in chat history; Gemini holds the conversation in its
# own session and writes nothing. Close the tab and it is gone.
# VITE_VOICE_ENGINE=sarvam

# Gemini voice name. One of Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr.
# Sarvam speaker names mean nothing here, so an unrecognised value falls back to
# Puck rather than being forwarded — an unknown voiceName is rejected mid-setup and
# surfaces as "voice is broken" rather than as a bad parameter.
# VITE_GEMINI_VOICE=Puck
